+#[test]
+fn fts_connection_after_graph_schema_publication() {
+    let folder = tempfile::tempdir().unwrap();
+    let path = folder.path().join("fts.sqlite3");
+    let mut writer = rusqlite::Connection::open(&path).unwrap();
+    writer.execute_batch("PRAGMA journal_mode=WAL; CREATE TABLE documents(id INTEGER PRIMARY KEY,path TEXT,hash TEXT); CREATE VIRTUAL TABLE chunks_fts USING fts5(body); INSERT INTO chunks_fts VALUES('очередь');").unwrap();
+    let reader = rusqlite::Connection::open(&path).unwrap();
+    let _: i64 = reader
+        .query_row("SELECT count(*) FROM documents", [], |r| r.get(0))
+        .unwrap();
+    let (start_tx, start_rx) = std::sync::mpsc::channel();
+    let (done_tx, done_rx) = std::sync::mpsc::channel();
+    let publish = std::thread::spawn(move || {
+        let mut generation = 0;
+        while start_rx
+            .recv_timeout(std::time::Duration::from_secs(2))
+            .is_ok()
+        {
+            writer.execute_batch(&format!("CREATE TABLE schema_publication_{generation}(id INTEGER)")).unwrap();
+            generation += 1;
+            done_tx.send(()).unwrap();
+        }
+    });
+    let active = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let flag = active.clone();
+    reader
+        .authorizer(Some(move |context: rusqlite::hooks::AuthContext<'_>| {
+            if let rusqlite::hooks::AuthAction::Read { table_name, .. } = context.action
+                && table_name == "chunks_fts_config"
+            {
+                flag.store(true,std::sync::atomic::Ordering::SeqCst);
+            }
+            rusqlite::hooks::Authorization::Allow
+        }))
+        .unwrap();
+    let mut fired = 0;
+    reader.progress_handler(1,Some(move || {
+        if active.load(std::sync::atomic::Ordering::SeqCst) && fired < 512 {
+            fired += 1;
+            start_tx.send(()).unwrap();
+            done_rx.recv_timeout(std::time::Duration::from_secs(2)).unwrap();
+        }
+        false
+    })).unwrap();
+    let result: Result<i64, _> = reader.query_row(
+        "SELECT count(*) FROM chunks_fts WHERE chunks_fts MATCH 'очередь'",
+        [],
+        |r| r.get(0),
+    );
+    reader.authorizer(None::<fn(rusqlite::hooks::AuthContext<'_>) -> rusqlite::hooks::Authorization>).unwrap();
+    reader.progress_handler(0,None::<fn()->bool>).unwrap();
+    publish.join().unwrap();
+    let count = result.unwrap();
+    assert_eq!(count, 1);
+}
